# Optional: enable AI query planning. Never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required to accept app events: Authorization: Bearer <APP_WEBHOOK_SECRET>
APP_WEBHOOK_SECRET=

# Hosted storage, supplied automatically by the Vercel Neon integration.
DATABASE_URL=

# Required for the Vercel Connection cron job.
CRON_SECRET=
